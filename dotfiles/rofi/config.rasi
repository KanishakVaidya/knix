configuration {
  modi:  "window,combi,run";
  show-icons: true;
  font: "Monospace 14";
  sidebar-mode: true;
  combi-modi: "drun,AppImages:~/.config/my_scripts/rofi_appimage.sh";
  combi-hide-mode-prefix: true;
  // combi {
  //   display-name: "Applications";
  // }
  kb-remove-to-eol: "";
  kb-accept-entry: "Return";
  kb-row-down: "Down,Control+j";
  kb-row-up: "Up,Control+k";
}
@theme "/home/keshav/.config/rofi/themes/oxide.rasi"
