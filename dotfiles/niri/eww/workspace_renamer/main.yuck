(defwindow workspace_renamer
    :monitor 0
    :geometry (geometry :anchor "bottom center")
    :stacking "overlay"
    :focusable "ondemand"
    :exclusive false
    (renamer))

(defwidget renamer []
  (eventbox
   :onhoverlost "eww -c . open --toggle workspace_renamer"
   (box
    :orientation "h"
    :active true
    (label :text "Enter workspace name: ")
    (input
     :style "border-bottom: 2px solid white; font-size: 20px;"
     :onaccept "niri msg action set-workspace-name '{}'; eww -c . open --toggle workspace_renamer"))))