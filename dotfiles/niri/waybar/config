{
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 8, // Gaps between modules (4px)
    "layer": "top", // Waybar at top layer

"modules-left": ["niri/window", "niri/submap"],
"modules-center": ["niri/workspaces"],
"modules-right": ["custom/myLang" , "custom/myBrightness", "custom/myVolume", "custom/myBattery", "clock", "custom/myinternet", "custom/mypowermenu", "tray"],

"hyprland/workspaces": {
    "all-outputs": false,
    "format": "{name}",
    "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "",
        "9": "󰇮",
        "urgent": "",
        "focused": "",
        "default": ""
    },
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
},

"hyprland/window": {
    "format": "{title}",
    "max-length": 50
},

"custom/myLang": {
    "exec": "~/.config/waybar/scripts/lang.sh",
    "exec-on-event": true,
    "signal": 13,
    "return-type": "json",
    "interval": "once",
    "on-click": "~/.config/waybar/scripts/lang.sh 1 > /dev/null"
},

"custom/myVolume": {
    "exec": "~/.config/waybar/scripts/volume.sh",
    "exec-on-event": true,
    "return-type": "json",
    "signal": 11,
    "interval": "once",
    "on-click": "~/.config/waybar/scripts/volume.sh 1 > /dev/null",
    "on-click-right": "~/.config/waybar/scripts/volume.sh 3 > /dev/null",
    "on-scroll-up": "~/.config/waybar/scripts/volume.sh 4 > /dev/null",
    "on-scroll-down": "~/.config/waybar/scripts/volume.sh 5 > /dev/null",
    "separate-outputs": false,
},

"custom/myBrightness": {
    "exec": "~/.config/waybar/scripts/amd_bl.sh",
    "return-type": "json",
    "exec-on-event": true,
    "signal": 12,
    "interval": "once",
    "on-scroll-up": "~/.config/waybar/scripts/amd_bl.sh 4 > /dev/null",
    "on-scroll-down": "~/.config/waybar/scripts/amd_bl.sh 5 > /dev/null",
},

"custom/myBattery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "return-type": "json",
    "interval": 60,
    "on-click": "~/.config/waybar/scripts/battery.sh > /dev/null"
},

"clock": {
    "format": " {:%a %b %d  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
                "mode"          : "year",
                "mode-mon-col"  : 3,
                "weeks-pos"     : "right",
                "on-scroll"     : 1,
                "on-click-right": "mode",
                "format": {
                          "months":     "<span color='#ffead3'><b>{}</b></span>",
                          "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                          "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                          "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                          "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
                          }
                },
    "actions":  {
                "on-click-right": "mode",
                "on-click-forward": "tz_up",
                "on-click-backward": "tz_down",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
                }
},

"custom/myinternet": {
    "exec": "~/.config/waybar/scripts/network.sh | jq --unbuffered --compact-output",
    "return-type": "json",
    "on-click": "networkmanager_dmenu",
    "on-click-right": "$TERMINAL -e -a myfloat nmtui",
    "interval": 3,
},

"custom/mypowermenu": {
    "format": "󰐥",
    "on-click": "~/.config/waybar/scripts/powermenu.sh",
},

"tray": {
        // "icon-size": 21,
        "spacing": 10
    },
}
